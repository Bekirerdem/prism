VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# WalletConnect / Reown project id — enables mobile wallets (Freighter mobile connects
# over WalletConnect v2). Get a free id at https://cloud.reown.com. Without it, only the
# desktop extension wallets are offered.
VITE_WALLETCONNECT_PROJECT_ID=

# --- E2E (Playwright) -------------------------------------------------------
# Enable the test-signer injection path. Compile-time flag: Vite replaces
# import.meta.env with literals at build time, so the dead code gets tree-shaken
# out of production builds. NEVER set this in a real production build — even with
# the flag set, the runtime still requires window.__EUNOMIA_TEST_SIGNER__ (set by
# Playwright via addInitScript) to actually do anything.
VITE_ENABLE_TEST_SIGNER=

# --- Relay (server-only, api/relay.ts) --------------------------------------
# NEVER prefix any of these with VITE_: Vite inlines VITE_* into the bundle as
# literals, so a VITE_-prefixed key ends up readable in the published main.js.
# These are read with process.env inside the serverless function only.
#
# OpenZeppelin Channels API key — get one at
# https://channels.openzeppelin.com/testnet/gen (mainnet: /gen). Free, fair-use
# quota per key, resets 24h after the first transaction.
OZ_CHANNELS_API_KEY=
# Defaults to the managed testnet service. Point this (plus a pluginId) at your
# own relayer to self-host without touching any other code.
OZ_CHANNELS_BASE_URL=
# Comma-separated. Fixed contracts the relay may call by address (the registry).
RELAY_ALLOWED_CONTRACTS=
# Comma-separated wasm hashes. Covers the per-user treasuries, whose addresses
# cannot be known up front — a contract is admitted when its code is ours.
RELAY_ALLOWED_WASM=
# Soroban RPC used to read a contract's wasm hash. Defaults to testnet.
RELAY_RPC_URL=

# For npx playwright test (CLI only — NOT a VITE_ var, never sent to the bundle).
# A funded throwaway Stellar testnet secret (S…). Must hold ≥ 25 XLM to cover
# deploy + fund + fee headroom. Generate one via @stellar/stellar-sdk Keypair.random()
# and fund it twice from https://friendbot.stellar.org/?addr=<public key>.
PLAYWRIGHT_TEST_WALLET_SECRET=
